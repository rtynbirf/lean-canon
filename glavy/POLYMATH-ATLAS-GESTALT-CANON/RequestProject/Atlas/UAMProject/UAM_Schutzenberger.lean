import Mathlib.Tactic
import RequestProject.Atlas.UAMProject.UAM_Directionality
import RequestProject.Atlas.UAMProject.UAM_Green
import RequestProject.Atlas.UAMProject.UAM_Idempotent
import RequestProject.Atlas.UAMProject.UAM_HClass
import RequestProject.Atlas.UAMProject.UAM_Regular

namespace UAMP_Schutzenberger
universe u

open UAMP_Green UAMP_Reachability UAMP_Regular UAMP_Idempotent UAMP_HClass

/-- D relation: equivalence generated by R ∪ L -/
def D_rel {M : Type u} [Monoid M] (a b : M) : Prop :=
  Relation.EqvGen (fun x y => R_eq x y ∨ L_eq x y) a b

/-- D-class of a -/
def DClass {M : Type u} [Monoid M] (a : M) : Set M := {b | D_rel a b}

/-- Semigroup where every element is regular -/
def IsRegularSemigroup (M : Type u) [Monoid M] : Prop := ∀ a : M, UAMP_Regular.IsRegular a

/-- R_eq characterization via reachability mutual inclusion -/
theorem R_eq_iff {M : Type u} [Monoid M] {a b : M} :
    R_eq a b ↔ a ∈ reach b ∧ b ∈ reach a := by
  constructor
  · intro h
    rw [R_eq, Set.ext_iff] at h
    exact ⟨(h a).mp (mem_reach_self a), (h b).mpr (mem_reach_self b)⟩
  · rintro ⟨h₁, h₂⟩
    exact R_eq_of_mem_reach h₂ h₁

/-- L_eq characterization via reachability mutual inclusion -/
theorem L_eq_iff {M : Type u} [Monoid M] {a b : M} :
    L_eq a b ↔ a ∈ reachLeft b ∧ b ∈ reachLeft a := by
  constructor
  · intro h
    rw [L_eq, Set.ext_iff] at h
    exact ⟨(h a).mp (mem_reachLeft_self a), (h b).mpr (mem_reachLeft_self b)⟩
  · rintro ⟨h₁, h₂⟩
    exact L_eq_of_mem_reachLeft h₂ h₁

/-- R включено в D. -/
theorem D_rel_of_R_eq {M : Type u} [Monoid M] {a b : M} (h : R_eq a b) : D_rel a b :=
  Relation.EqvGen.rel _ _ (Or.inl h)

/-- L включено в D. -/
theorem D_rel_of_L_eq {M : Type u} [Monoid M] {a b : M} (h : L_eq a b) : D_rel a b :=
  Relation.EqvGen.rel _ _ (Or.inr h)

/-- D — отношение эквивалентности. -/
theorem D_rel_equivalence {M : Type u} [Monoid M] :
    Equivalence (D_rel (M := M)) := Relation.EqvGen.is_equivalence _

/-- Композиция R и L лежит в D. -/
theorem D_rel_of_R_comp_L {M : Type u} [Monoid M] {a b c : M}
    (hR : R_eq a c) (hL : L_eq c b) : D_rel a b :=
  D_rel_equivalence.trans (D_rel_of_R_eq hR) (D_rel_of_L_eq hL)

/- Архивные утверждения `green_swap` (перестановочность R и L на регулярных
элементах) и `D_eq_R_comp_L_regular` (`D = R ∘ L`) оставлены без доказательства
в исходном архиве и не воспроизводятся здесь: приведённые там «доказательства»
были некорректны (в частности, `EqvGen.rel _ _ (Or.inl hR)` доказывает
`D_rel a c`, а не `D_rel a b`). Доказано включение `R ∘ L ⊆ D`. -/

end UAMP_Schutzenberger
