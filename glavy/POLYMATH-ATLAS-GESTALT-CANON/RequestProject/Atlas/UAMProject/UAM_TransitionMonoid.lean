import Mathlib.Data.Fintype.Card
import Mathlib.Data.Fintype.Basic
import Mathlib.Data.List.Basic
import Mathlib.Tactic
import RequestProject.Atlas.UAMProject.UAM_Free
import RequestProject.Atlas.UAMProject.UAM_Congruence
import RequestProject.Atlas.UAMProject.UAM_Morphism
import RequestProject.Atlas.UAMProject.UAM_DFAEval
import RequestProject.Atlas.UAMProject.UAM_Action

namespace UAMP_TransitionMonoid
universe u

open UAMP_Free hiding FreeMonoid
open UAMP_Morphism UAMP_DFAEval

variable {α Q : Type u} [DecidableEq Q] (A : DFA α Q)

/-- Action homomorphism from UAMP_Free.FreeMonoid α to (Q → Q): w ↦ (q ↦ evalFrom q w) -/
def actionHom : MonoidMorphism (UAMP_Free.FreeMonoid α) (Q → Q) where
  toFun := fun w q => evalFrom A q w
  map_mul := fun _ _ => by
    funext q
    exact evalFrom_concat A q _ _
  map_one := by
    funext q
    rfl

/-- Transition monoid: submonoid of Q → Q generated by the action -/
def TransitionMonoid : Submonoid (Q → Q) where
  carrier := Set.range (actionHom A).toFun
  one_mem' := ⟨[], (actionHom A).map_one ▸ rfl⟩
  mul_mem' := by
    rintro f g ⟨w₁, hw₁⟩ ⟨w₂, hw₂⟩
    refine ⟨w₁ ++ w₂, ?_⟩
    rw [show w₁ ++ w₂ = w₁ * w₂ from rfl, (actionHom A).map_mul, hw₁, hw₂]

/-- Конгруэнция-ядро действия автомата. -/
def actionCongruence : UAMP_Congruence.IsCongruence (UAMP_Free.FreeMonoid α) :=
  UAMP_Morphism.kernel (actionHom A)

/-- Факторизация свободного моноида по ядру действия вкладывается в `Q → Q`. -/
def transitionLift :
    MonoidMorphism (UAMP_Congruence.QuotientMonoid (actionCongruence A)) (Q → Q) :=
  UAMP_Morphism.liftThroughQuotient (actionHom A) (fun _ _ h => h)

/-- Это вложение инъективно (в архиве утверждение было оставлено без доказательства). -/
theorem transitionLift_injective : Function.Injective (transitionLift A).toFun :=
  UAMP_Morphism.liftThroughQuotient_injective _ _

/-- Для конечного множества состояний фактор конечен
(в архиве инстанс был оставлен без доказательства). -/
instance instFiniteKerQuotient [Finite Q] :
    Finite (UAMP_Congruence.QuotientMonoid (actionCongruence A)) :=
  Finite.of_injective _ (transitionLift_injective A)

/-- Action hom equality is preserved by TransitionMonoid membership -/
theorem actionHom_eq_iff (w₁ w₂ : UAMP_Free.FreeMonoid α) :
    (actionHom A).toFun w₁ = (actionHom A).toFun w₂ ↔
    ∀ q, evalFrom A q w₁ = evalFrom A q w₂ := by
  constructor
  · intro h q
    exact congrFun h q
  · intro h
    funext q
    exact h q

end UAMP_TransitionMonoid
