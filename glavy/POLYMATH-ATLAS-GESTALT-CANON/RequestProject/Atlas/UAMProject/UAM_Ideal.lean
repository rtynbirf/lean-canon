import Mathlib.Tactic
import RequestProject.Atlas.UAMProject.UAM_Directionality
import RequestProject.Atlas.UAMProject.UAM_Idempotent
import RequestProject.Atlas.UAMProject.UAM_Regular
import RequestProject.Atlas.UAMProject.UAM_Congruence

namespace UAMP_Ideal
universe u

open UAMP_Regular UAMP_Congruence

variable {M : Type u} [Monoid M]

/-- Left ideal: nonempty + absorbs multiplication on left -/
structure IsLeftIdeal (I : Set M) : Prop where
  nonempty : I.Nonempty
  left_absorb : ∀ a m, m ∈ I → a * m ∈ I

/-- Right ideal: nonempty + absorbs multiplication on right -/
structure IsRightIdeal (I : Set M) : Prop where
  nonempty : I.Nonempty
  right_absorb : ∀ a m, m ∈ I → m * a ∈ I

/-- Two-sided ideal: both left and right ideal -/
structure IsIdeal (I : Set M) : Prop where
  isLeftIdeal : IsLeftIdeal I
  isRightIdeal : IsRightIdeal I

/-- Principal right ideal generated by a: a * M -/
def principalRight (a : M) : Set M := {b | ∃ c, a * c = b}

/-- Principal left ideal generated by a: M * a -/
def principalLeft (a : M) : Set M := {b | ∃ c, c * a = b}

theorem principalRight_isRightIdeal (a : M) : IsRightIdeal (principalRight a) := by
  refine ⟨⟨a, ⟨1, by rw [mul_one]⟩⟩, ?_⟩
  rintro x m ⟨c, hc⟩
  exact ⟨c * x, by rw [← mul_assoc, hc]⟩

theorem principalLeft_isLeftIdeal (a : M) : IsLeftIdeal (principalLeft a) := by
  refine ⟨⟨a, ⟨1, by rw [one_mul]⟩⟩, ?_⟩
  rintro x m ⟨c, hc⟩
  exact ⟨x * c, by rw [mul_assoc, hc]⟩

/-- Rees congruence: collapses an ideal to a single point.
(В архивной версии идеал передавался как instance-аргумент, что не разрешалось
поиском инстансов; здесь это обычный явный аргумент.) -/
def reesCongruence (I : Set M) (hI : IsIdeal I) : IsCongruence M where
  r := fun a b => a = b ∨ (a ∈ I ∧ b ∈ I)
  refl := fun _ => Or.inl rfl
  symm := fun _ _ h => h.elim (fun h => Or.inl h.symm) (fun h => Or.inr ⟨h.2, h.1⟩)
  trans := fun a b c hab hbc => by
    rcases hab with h | h
    · subst h; exact hbc
    · rcases hbc with h' | h'
      · exact Or.inr ⟨h.1, h' ▸ h.2⟩
      · exact Or.inr ⟨h.1, h'.2⟩
  mul_compat := fun a b c d hab hcd => by
    rcases hab with h | h
    · subst h
      rcases hcd with h' | h'
      · exact Or.inl (by rw [h'])
      · exact Or.inr ⟨hI.isLeftIdeal.left_absorb a c h'.1,
          hI.isLeftIdeal.left_absorb a d h'.2⟩
    · rcases hcd with h' | h'
      · subst h'
        exact Or.inr ⟨hI.isRightIdeal.right_absorb c a h.1,
          hI.isRightIdeal.right_absorb c b h.2⟩
      · exact Or.inr ⟨hI.isLeftIdeal.left_absorb a c h'.1,
          hI.isLeftIdeal.left_absorb b d h'.2⟩
  one_compat := Or.inl rfl

theorem principalRight_eq_reach (a : M) : principalRight a = UAMP_Reachability.reach a := rfl

theorem principalLeft_eq_reachLeft (a : M) : principalLeft a = UAMP_Reachability.reachLeft a := rfl

end UAMP_Ideal
