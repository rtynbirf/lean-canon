import Mathlib

/-!
# UAM: «Начало» — от строк к конечным автоматам

Этот файл продолжает проект **UAM (Universal Algebra of Models)**.
Здесь показано, что **детерминированный конечный автомат (DFA)** с начальным
состоянием `q₀` является прямым частным случаем универсальной формулы «начала»:

  `∃! x₀ ∈ X, ∀ x ∈ X, x₀ ≤ x`

Множество `X` — это множество **вычислительных путей (traces)** автомата, а
порядок `≤` — отношение «быть префиксом». Начальное состояние `q₀` порождает
наименьший путь `[q₀]`, который является единственным наименьшим элементом.

Три грамматических смысла «начала» распакованы для DFA:

* **Существительное** (точка отсчёта): `q₀` — начальное состояние, наименьший путь.
* **Глагол** (действие): `init` — запуск автомата из `q₀`, левая единица свёртки.
* **Прошедшее время** (результат): `δ(q₀, a)` — состояние после первого шага.

Аксиомы начала:

* **B1** (Существование): наименьший путь существует — `initial_is_beginning`.
* **B2** (Единственность): он единственен — `initial_is_beginning` / `beginning_state_unique`.
* **B3** (Действие): `q₀` — левая единица свёртки — `eval_left_unit`.
* **B4** (Результат): `pastBeginning` — состояние после первого шага — `pastBeginning_eq`.
-/

namespace UAM.Automaton

universe u v

/-! ## §1. Определение DFA как алгебраической структуры

`DFA = (Q, Σ, δ, q₀, F)`, где `Q` — конечное множество состояний, `Σ` — алфавит
(параметр `S`), `δ` — функция перехода, `q₀` — начальное состояние,
`F` — множество допускающих состояний. -/

/-- Детерминированный конечный автомат над алфавитом `S`. -/
structure DFA (S : Type u) where
  /-- Множество состояний. -/
  Q : Type v
  /-- Состояний конечно много. -/
  [fQ : Fintype Q]
  /-- Функция перехода. -/
  δ : Q → S → Q
  /-- Начальное состояние. -/
  q₀ : Q
  /-- Множество допускающих состояний. -/
  F : Set Q

attribute [instance] DFA.fQ

/-! ### Отношение «быть префиксом» (`<+:`) — частичный порядок

Мы используем стандартное отношение `List.IsPrefix` из Mathlib (`l₁ <+: l₂`).
Ниже — три закона частичного порядка (рефлексивность, транзитивность,
антисимметрия), составляющие §1. -/

/-- Рефлексивность: путь является префиксом самого себя. -/
theorem prefix_refl' {α : Type*} (l : List α) : l <+: l :=
  List.prefix_refl l

/-- Транзитивность порядка по префиксу. -/
theorem prefix_trans' {α : Type*} {l₁ l₂ l₃ : List α}
    (h₁ : l₁ <+: l₂) (h₂ : l₂ <+: l₃) : l₁ <+: l₃ :=
  h₁.trans h₂

/-- Антисимметрия: два взаимных префикса равны. -/
theorem prefix_antisymm' {α : Type*} {l₁ l₂ : List α}
    (h₁ : l₁ <+: l₂) (h₂ : l₂ <+: l₁) : l₁ = l₂ := by
  have := h₁.length_le
  have := h₂.length_le
  exact h₁.eq_of_length_le (by omega)

/-! ## §6 (сначала). Вычисление как свёртка

`eval M w = foldl δ q₀ w` — итоговое состояние после чтения слова `w`, то есть
свёртка входного слова функцией перехода, начиная с `q₀`. Здесь `q₀` играет ту же
роль, что `[]` для списков — нейтральный старт свёртки. -/

/-- Итоговое состояние автомата после чтения слова `w`. -/
def DFA.eval (M : DFA S) (w : List S) : M.Q := List.foldl M.δ M.q₀ w

/-- Вычислительный путь (trace): последовательность посещённых состояний,
начиная с `q₀`. -/
def DFA.run (M : DFA S) (w : List S) : List M.Q := List.scanl M.δ M.q₀ w

/-- Множество всех вычислительных путей автомата. -/
def DFA.traces (M : DFA S) : Set (List M.Q) := Set.range M.run

/-- На пустом слове вычисление даёт начальное состояние — аналог `[] ` как
нейтрального элемента (§6). -/
theorem DFA.eval_nil (M : DFA S) : M.eval [] = M.q₀ := rfl

/-- Свёртка по конкатенации: чтение `v ++ w` = дочтение `w` из состояния после `v`.
Прямой аналог `foldl` по `++` для списков (§6). -/
theorem DFA.eval_append (M : DFA S) (v w : List S) :
    M.eval (v ++ w) = List.foldl M.δ (M.eval v) w := by
  simp [DFA.eval, List.foldl_append]

/-- Путь на пустом слове — это одноэлементный путь `[q₀]`. -/
theorem DFA.run_nil (M : DFA S) : M.run [] = [M.q₀] := rfl

/-- Путь всегда начинается с начального состояния: `[q₀]` — префикс любого пути. -/
theorem DFA.singleton_prefix_run (M : DFA S) (w : List S) :
    [M.q₀] <+: M.run w := by
  cases w with
  | nil => simp [DFA.run]
  | cons a l => simp [DFA.run, List.scanl_cons, List.cons_prefix_cons]

/-! ## §2. `q₀` — наименьший элемент (Начало как существительное)

Начальное состояние порождает наименьший путь `[q₀]`, и он — **единственный**
наименьший элемент множества вычислений. Это прямая инстанциация формулы
`∃! x₀, ∀ x, x₀ ≤ x` (аксиомы B1 существование и B2 единственность). -/

/-- **§2 / B1, B2.** Существует единственный наименьший (по префиксу) путь среди
всех вычислений автомата, и это путь `[q₀]`, порождённый начальным состоянием. -/
theorem initial_is_beginning (M : DFA S) :
    ∃! r₀ : List M.Q, r₀ ∈ M.traces ∧ ∀ r ∈ M.traces, r₀ <+: r := by
  refine ⟨[M.q₀], ⟨⟨[], rfl⟩, ?_⟩, ?_⟩
  · rintro r ⟨w, rfl⟩
    exact M.singleton_prefix_run w
  · rintro r₀ ⟨⟨w, rfl⟩, hmin⟩
    have h₁ : [M.q₀] <+: M.run w := M.singleton_prefix_run w
    have h₂ : M.run w <+: [M.q₀] := hmin [M.q₀] ⟨[], rfl⟩
    exact prefix_antisymm' h₂ h₁

/-! ## §3. `init` — морфизм `I → X` (Начало как глагол)

Действие «запустить»: `init` — это запуск автомата из `q₀`, дающий наименьший
путь `[q₀]`. С точки зрения моноида вычислений `q₀` — **левая единица** свёртки
(аксиома B3), аналог `"" ++ s = s` для строк. -/

/-- Запуск автомата: наименьший путь `[q₀]` (морфизм `I → X`). -/
def DFA.init (M : DFA S) : List M.Q := M.run []

/-- `init` — это в точности одноэлементный путь `[q₀]`. -/
theorem DFA.init_eq (M : DFA S) : M.init = [M.q₀] := rfl

/-- **§3 / B3.** `q₀` — левая единица свёртки: вычисление любого слова `w`
совпадает со свёрткой из состояния пустого слова. Аналог `"" ++ s = s`. -/
theorem eval_left_unit (M : DFA S) (w : List S) :
    M.eval w = List.foldl M.δ (M.eval []) w := by
  rw [DFA.eval_nil]; rfl

/-! ## §4. `δ(q₀, a)` — «прошедшее начало» (Начало как прошедшее время)

Результат первого шага: состояние после чтения первого символа `a`. Это второй
элемент минимального нетривиального пути `run M [a] = [q₀, δ(q₀, a)]` (аксиома B4). -/

/-- «Прошедшее начало»: состояние после первого шага. -/
def DFA.pastBeginning (M : DFA S) (a : S) : M.Q := M.δ M.q₀ a

/-- **§4 / B4.** «Прошедшее начало» — это результат чтения одного символа из `q₀`. -/
theorem pastBeginning_eq (M : DFA S) (a : S) :
    M.pastBeginning a = M.eval [a] := rfl

/-- Минимальный нетривиальный путь: `run M [a] = [q₀, δ(q₀, a)]`, где второй
элемент — «прошедшее начало». -/
theorem DFA.run_singleton (M : DFA S) (a : S) :
    M.run [a] = [M.q₀, M.pastBeginning a] := rfl

/-! ## §7. Единственность начального состояния

Если состояние `q` порождает наименьший путь `[q]` среди всех вычислений (т.е.
`q` удовлетворяет определению начала), то `q = q₀`. Доказательство — через
антисимметрию порядка на путях. -/

/-- **§7 / B2.** Единственность начального состояния: любое состояние `q`, чей
одноэлементный путь `[q]` является наименьшим элементом множества вычислений,
совпадает с `q₀`. -/
theorem beginning_state_unique (M : DFA S) (q : M.Q)
    (hmem : [q] ∈ M.traces) (hmin : ∀ r ∈ M.traces, [q] <+: r) :
    q = M.q₀ := by
  have h₁ : [q] <+: [M.q₀] := hmin [M.q₀] ⟨[], rfl⟩
  have h₂ : [M.q₀] <+: [q] := by
    obtain ⟨w, hw⟩ := hmem
    have := M.singleton_prefix_run w
    rw [hw] at this
    exact this
  have : [q] = [M.q₀] := prefix_antisymm' h₁ h₂
  simpa using this

end UAM.Automaton
