import Mathlib.Data.Set.Basic
import Mathlib.Algebra.Group.Defs

/-!
# Principal ideals

Lightweight definitions of principal one-sided and two-sided ideals.  They live in
the `UAM_Ideal` namespace but are separated from the closure theory so Green's
relations can use them without creating an import cycle.
-/

namespace UAM_Ideal

universe u

variable {M : Type u} [Monoid M]

/-- The principal left ideal generated by `a`: `M · a`. -/
def principalLeft (a : M) : Set M := {x | ∃ y, y * a = x}

/-- The principal right ideal generated by `a`: `a · M`. -/
def principalRight (a : M) : Set M := {x | ∃ y, a * y = x}

/-- The principal two-sided ideal generated by `a`: `M · a · M`. -/
def principalIdeal (a : M) : Set M := {x | ∃ y z, y * a * z = x}

end UAM_Ideal
