    ⟨42, "Исходная",                    "Наличие самого начала"⟩ ]

/-- Уровень с номером `n`, если он существует. -/
def level (n : Nat) : Option Level := levels[n]?

/-- Шкала содержит сорок три уровня. -/
theorem levels_length : levels.length = 43 := by decide

/-- Номера уровней идут подряд от нуля. -/
theorem levels_idx : ∀ n : Fin 43, (levels[n.val]?).map Level.idx = some n.val := by
  decide

/-- **Закон уникальности имени.** Имена уровней попарно различны. -/
theorem law_of_unique_name : (levels.map Level.name).Nodup := by decide

/-- Частный случай закона уникальности имени: `L13` — Онтологическая. -/
theorem level13_is_ontological :
    (level 13).map Level.name = some "Онтологическая" := by decide

/-- Частный случай закона уникальности имени: `L14` — Аксиологическая. -/
theorem level14_is_axiological :
    (level 14).map Level.name = some "Аксиологическая" := by decide

/-- **Закон отрицания.** Соседние уровни отрицают разные инварианты. -/
theorem law_of_negation : ∀ n : Fin 42,
    (levels[n.val]?).map Level.negatedInvariant ≠
      (levels[n.val + 1]?).map Level.negatedInvariant := by
  decide

/-- Уровни `L29` и `L30` отрицают инварианты, прямо противоположные друг другу:
«наличие различий» и «отсутствие различий». -/
theorem levels_29_30_opposite :
    (level 29).map Level.negatedInvariant = some "Наличие различий" ∧
    (level 30).map Level.negatedInvariant = some "Отсутствие различий" := by
  decide

/-- Виток канона: римский номер, границы и название. -/
structure Arc where
  /-- Номер витка (римская запись из текста канона). -/
  numeral : String
  /-- Первый уровень витка. -/
  first : Nat
  /-- Последний уровень витка. -/
  last : Nat
  /-- Название витка. -/
  title : String
deriving Repr, DecidableEq

/-- Девять витков канона. -/
def arcs : List Arc :=
  [ ⟨"I",    0,  4,  "Мир объектов"⟩,
    ⟨"II",   5,  9,  "Мир систем"⟩,
    ⟨"III",  10, 15, "Мир познания"⟩,
    ⟨"IV",   16, 21, "Мир генерации"⟩,
    ⟨"V",    22, 29, "Распад категорий"⟩,
    ⟨"VI",   30, 30, "Точка сборки"⟩,
    ⟨"VII",  31, 35, "Мета-спираль"⟩,
    ⟨"VIII", 36, 40, "Распад уровней"⟩,
    ⟨"IX",   41, 42, "Трансценденталь"⟩ ]

/-- Витков девять. -/
theorem arcs_length : arcs.length = 9 := by decide

/-- Уровень `n` принадлежит витку `a`. -/
def inArc (a : Arc) (n : Nat) : Prop := a.first ≤ n ∧ n ≤ a.last

instance (a : Arc) (n : Nat) : Decidable (inArc a n) := by
  unfold inArc
  infer_instance

/-- **Закон витков.** Каждый уровень шкалы лежит ровно в одном витке. -/
theorem law_of_arcs_partition : ∀ n : Fin 43,
    (arcs.filter (fun a => decide (inArc a n.val))).length = 1 := by
  decide

/-- Витки покрывают ровно шкалу `0…42` и ничего сверх неё. -/
theorem arcs_cover_scale : ∀ n : Fin 50,
    (∃ a ∈ arcs, inArc a n.val) ↔ n.val ≤ 42 := by
  decide

/-- **Закон замыкания.** Контекстуальный уровень, точка сборки и исходный
уровень лежат в трёх разных витках: `L30` и `L42` — мета-отражения `L0`,
а не его повторения. -/
theorem law_of_closure :
    ∃ a₀ ∈ arcs, ∃ a₃₀ ∈ arcs, ∃ a₄₂ ∈ arcs,
      inArc a₀ 0 ∧ inArc a₃₀ 30 ∧ inArc a₄₂ 42 ∧
      a₀ ≠ a₃₀ ∧ a₃₀ ≠ a₄₂ ∧ a₀ ≠ a₄₂ := by
  refine ⟨arcs[0], by decide, arcs[5], by decide, arcs[8], by decide, ?_⟩
  decide

/-- **Закон выхода.** После `L42` уровня в шкале нет: продолжение канона
требует новой шкалы, а не следующего уровня. -/
theorem law_of_exit : level 43 = none := by decide

/-- Ни один уровень с номером больше сорока двух не определён. -/
theorem no_level_above_42 : ∀ n : Nat, 42 < n → level n = none := by
  intro n hn
  have h : levels.length ≤ n := by rw [levels_length]; omega
  simpa [level] using List.getElem?_eq_none h

end Canon.L0L42
