import Mathlib

/-!
# Канон L0–L42

Формализация итогового канона уровней `L0–L42` с отрицаемыми инвариантами,
девятью витками и ключевыми законами. Источник — текст канона, приложенный
к проекту (`L0-L42_Canon.pdf`).

Ничего сверх текста здесь не утверждается: уровни и витки записаны как данные,
а «законы» канона — как проверяемые свойства этих данных.

* `Level`, `levels` — сорок три уровня: номер, имя, отрицаемый инвариант;
* `levels_length`, `levels_idx` — шкала занумерована `0…42` без пропусков;
* `law_of_unique_name` — имена уровней попарно различны;
  частные случаи — `level13_is_ontological`, `level14_is_axiological`;
* `law_of_negation` — соседние уровни отрицают разные инварианты;
* `Arc`, `arcs` — девять витков;
* `law_of_arcs_partition` — витки разбивают шкалу: каждый уровень лежит ровно
  в одном витке;
* `law_of_closure` — `L0`, `L30` и `L42` лежат в трёх разных витках
  (точка сборки и исходный уровень как мета-отражения контекстуального);
* `law_of_exit` — после `L42` уровня нет: шкала заканчивается.
-/

namespace Canon.L0L42

/-- Уровень канона: номер, имя и отрицаемый им инвариант. -/
structure Level where
  /-- Номер уровня в шкале `L0–L42`. -/
  idx : Nat
  /-- Имя уровня. -/
  name : String
  /-- Инвариант, отрицаемый уровнем. -/
  negatedInvariant : String
deriving Repr, DecidableEq

/-- Полный список уровней канона в порядке `L0 … L42`. -/
def levels : List Level :=
  [ ⟨0,  "Контекстуальная",             "Отсутствие фона"⟩,
    ⟨1,  "Экземплярная",                "Единство контекста"⟩,
    ⟨2,  "Классификационная",           "Разрозненность экземпляров"⟩,
    ⟨3,  "Экстенсиональная",            "Фиксированность класса"⟩,
    ⟨4,  "Интенсиональная",             "Внешний объём"⟩,
    ⟨5,  "Структурная",                 "Атомарность свойств"⟩,
    ⟨6,  "Реляционная",                 "Изолированность частей"⟩,
    ⟨7,  "Системная",                   "Суммативность связей"⟩,
    ⟨8,  "Функциональная",              "Статичность системы"⟩,
    ⟨9,  "Каузальная",                  "Случайность функций"⟩,
    ⟨10, "Методологическая",            "Интуитивность познания"⟩,
    ⟨11, "Эпистемическая",              "Наивный реализм"⟩,
    ⟨12, "Семантическая",               "Однозначность смысла"⟩,
    ⟨13, "Онтологическая",              "Предзаданность сущего"⟩,
    ⟨14, "Аксиологическая",             "Нейтральность онтологии"⟩,
    ⟨15, "Телологическая",              "Бесцельность ценностей"⟩,
    ⟨16, "Метагенеративная",            "Статичность целей"⟩,
    ⟨17, "Рефлексивная",                "Внешний источник новизны"⟩,
    ⟨18, "Цивилизационная",             "Индивидуальная рефлексия"⟩,
    ⟨19, "Эволюционная",                "Фиксированность цивилизационных форм"⟩,
    ⟨20, "Космологическая",             "Локальность эволюции"⟩,
    ⟨21, "Метакосмологическая",         "Единственность физического мира"⟩,
    ⟨22, "Метазаконная",                "Неподвижность метамиров"⟩,
    ⟨23, "Механизменная",               "Конкретные законы"⟩,
    ⟨24, "Дефиниционная (темпоральная)", "Объективность изменения"⟩,
    ⟨25, "Экзистенциальная",            "Предзаданность времени"⟩,
    ⟨26, "Пограничная",                 "Чёткость бытия"⟩,
    ⟨27, "Субъект-объектная",           "Независимость наблюдателя"⟩,
    ⟨28, "Наблюдательная",              "Внешность наблюдателя"⟩,
    ⟨29, "Дифференциальная",            "Наличие различий"⟩,
    ⟨30, "Первичная дифференциация",    "Отсутствие различий"⟩,
    ⟨31, "Рекурсивная",                 "Линейность спирали"⟩,
    ⟨32, "Топологическая",              "Иерархичность «выше/ниже»"⟩,
    ⟨33, "Автореферентная",             "Внешнее описание шкалы"⟩,
    ⟨34, "Идентичностная",              "Биекция «имя ↔ число»"⟩,
    ⟨35, "Глубинная",                   "Фиксированность d(S)"⟩,
    ⟨36, "Нулевая",                     "Наличие уровня"⟩,
    ⟨37, "Квантовая",                   "Дискретность уровней"⟩,
    ⟨38, "Нелокальная",                 "Локальность изменений"⟩,
    ⟨39, "Трансфинитная",               "Счётность уровней"⟩,
